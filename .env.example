# ========================================================
# PUBLIC WEBSITE SERVER (public-server/.env)
# ========================================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DB_PATH=./public_data.db
ENCRYPTION_KEY=64_character_hex_string_for_aes_256_gcm_replace_this
ORGANIZER_SECRET_PASS=replace_with_strong_random_key
RETENTION_DAYS=30
EVENT_DATE=2026-10-31

# ========================================================
# PRIVATE ORGANISER DASHBOARD (organizer-dashboard/.env)
# ========================================================
PORT=5001
NODE_ENV=development
DB_PATH=./organizer_data.db
SESSION_SECRET=replace_with_strong_random_session_secret
